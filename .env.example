# Copy to .env. Docker Compose reads .env automatically; every value below has a dev default.

# claudeGenData: set ONE of these. Claude Pro/Max subscription: run `claude setup-token` and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=
# Or pay-as-you-go API billing with a key from https://platform.claude.com/
ANTHROPIC_API_KEY=

# Postgres superuser (used only by db-init to create the per-app databases).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Per-app database passwords (role name = database name). Use URL-safe characters: they go into DATABASE_URL.
CLAUDEGENDATA_DB_PASSWORD=claudeGenData
RANDOMHTMLTABLES_DB_PASSWORD=randomHtmlTables

# randomHtmlTables: largest N per run, and how many runs generate at once (the rest wait).
RANDOMHTMLTABLES_MAX_COUNT=100000
RANDOMHTMLTABLES_MAX_CONCURRENT_RUNS=2

# Hostname for the self-signed dev certificate (ignored if nginx/certs already has one).
CERT_HOSTNAME=localhost

# Host ports.
HTTP_PORT=80
HTTPS_PORT=443
DB_HOST_PORT=5432
PGWEB_HOST_PORT=8081

# pgweb (docker-compose.pgweb.yml). true = also at https://<host>/pgweb/ via the main nginx, which listens on all
# interfaces: set a login below unless this machine isn't reachable by others. Restart pgweb after changing.
PGWEB_VIA_HTTPS=false
PGWEB_AUTH_USER=
PGWEB_AUTH_PASS=
