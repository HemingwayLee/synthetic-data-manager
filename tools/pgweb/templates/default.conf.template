# Sits in front of pgweb: forwards everything to it and adds our scripts (./custom) to its page.
# This is an nginx image template: ${PGWEB_VIA_HTTPS} is filled in from the environment when the container starts.

# Docker's DNS, looked up per request: nginx starts even while pgweb is still (re)starting.
resolver 127.0.0.11 valid=10s ipv6=off;

# Shared by both listeners below.
proxy_http_version 1.1;
proxy_set_header Host $host;
# sub_filter can't edit compressed responses.
proxy_set_header Accept-Encoding "";
# Match pgweb's own query timeout (300 s).
proxy_read_timeout 300s;
# Relative, so it works both at / (port 8081) and under /pgweb/ (port 443).
sub_filter '</body>' '<script src="custom/json-viewer.js"></script></body>';
sub_filter_once on;

# http://localhost:8081, published on 127.0.0.1 only.
server {
    listen 8081;

    location / {
        set $upstream http://pgweb:8081;
        proxy_pass $upstream;
    }

    location /custom/ {
        alias /usr/share/nginx/pgweb-custom/;
        # Edits show up on reload.
        add_header Cache-Control "no-store";
    }
}

# Not published: the main stack's nginx forwards https://<host>/pgweb/ here (nginx/apps/pgweb.conf), prefix stripped.
# Answers 404 unless PGWEB_VIA_HTTPS=true.
server {
    listen 8082;

    set $via_https "${PGWEB_VIA_HTTPS}";
    if ($via_https != "true") {
        return 404 "pgweb over HTTPS is off: set PGWEB_VIA_HTTPS=true and restart pgweb.\n";
    }

    location / {
        set $upstream http://pgweb:8081;
        proxy_pass $upstream;
    }

    location /custom/ {
        alias /usr/share/nginx/pgweb-custom/;
        add_header Cache-Control "no-store";
    }
}
